# ==============================================================
# Exemplo de variaveis de ambiente — NAO coloque valores reais aqui.
# Copie para .env (ignorado pelo git) e ajuste localmente.
# Segredos de producao ficam no GitHub Actions Secrets / AWS, nunca no repo.
# ==============================================================

# --------------------------------------------------------------
# Ambiente fiscal (servico-faturamento)
# --------------------------------------------------------------
# Padrao: homologacao (tpAmb=2). Sem esta variavel o sistema SEMPRE usa
# homologacao. "producao" so e aceito junto com a confirmacao abaixo.
NFE_AMBIENTE=homologacao
# Guarda extra para producao: deve ser exatamente EMITIR-NFE-COM-VALOR-FISCAL.
# Deixe vazio fora de producao.
NFE_CONFIRMAR_PRODUCAO=

# --------------------------------------------------------------
# AWS / DynamoDB (Lambdas Go e API .NET)
# --------------------------------------------------------------
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=nfe-main-local
DYNAMODB_EVENTS_TABLE_NAME=nfe-events-local
EVENT_BUS_NAME=nfe-events-local
PDF_BUCKET_NAME=nfe-pdfs-local
CLOUDFRONT_DOMAIN=
CORS_ORIGINS=http://localhost:4200
ENVIRONMENT=local
LOG_LEVEL=info

# Endpoint do DynamoDB Local (docker compose / testes de integracao Go).
# Deixe vazio para usar a AWS real.
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
DYNAMODB_ENDPOINT=http://localhost:8000

# Credenciais FICTICIAS aceitas pelo DynamoDB Local. Nunca use chaves reais aqui.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --------------------------------------------------------------
# Portas locais (docker compose)
# --------------------------------------------------------------
DYNAMODB_LOCAL_PORT=8000
SERVICO_ESTOQUE_PORT=5001
SERVICO_FATURAMENTO_PORT=5002
WEBAPP_PORT=4200

# --------------------------------------------------------------
# Modo HTTP / demo gratuita (servico-faturamento/cmd/lambda/http_demo.go)
# --------------------------------------------------------------
# Definido = serve HTTP comum em vez de rodar como Lambda (ex.: ":8080").
HTTP_ADDR=
# Executa a reserva de estoque e o PDF de forma sincrona (sem EventBridge/SQS/S3).
DEMO_SAGA_SINCRONA=false
DEMO_PDF_SINCRONO=false
# Cria as tabelas no DynamoDB Local ao iniciar.
DEMO_CRIAR_TABELAS=false
# URL interna da API de estoque para o proxy de /api/v1/produtos e /api/v1/reservas.
ESTOQUE_INTERNAL_URL=
# URL publica usada nos links de PDF (vazio = deriva do Host da requisicao).
DEMO_PUBLIC_URL=

# --------------------------------------------------------------
# Frontend (web-app/scripts/generate-runtime-config.mjs)
# --------------------------------------------------------------
API_ESTOQUE_URL=http://localhost:4200/api/estoque
API_FATURAMENTO_URL=http://localhost:4200/api/faturamento
AUTH_ENABLED=false

# --------------------------------------------------------------
# Deploy AWS (manual; usado apenas por scripts em infra/scripts)
# --------------------------------------------------------------
AWS_ACCOUNT_ID=000000000000
FRONTEND_BUCKET_NAME=nfe-frontend-dev-000000000000
CLOUDFRONT_DISTRIBUTION_ID=EXXXXXXXXXXXXX
