# AWS Cost Kill-Switch Configuration
#
# Copy this file to .env and customize as needed
# Usage: source scripts/.env && ./scripts/aws-cost-kill-switch.sh
#

# AWS Configuration
# -----------------
# Default region for AWS operations
AWS_REGION=us-east-1

# AWS profile to use (optional)
# If not set, uses default credentials from ~/.aws/credentials
# AWS_PROFILE=production

# Script Behavior
# ---------------
# Set to 0 to execute actions (requires confirmation)
# Set to 1 for dry-run mode (default, safe)
DRY_RUN=1

# Specific Resource IDs (from Phase 0 analysis)
# ----------------------------------------------
TARGET_EC2_INSTANCE=i-01052b975ba194c38
TARGET_RDS_INSTANCE=nfe-db-dev

# VPC Endpoints to manage
TARGET_VPC_ENDPOINTS=(
    "vpce-0a0aff9ce09d31a6e"   # SQS
    "vpce-0398750a084ae4b6b"   # Secrets Manager
    "vpce-09fd8fb6127de41a9"   # EventBridge
)

# Safety Options
# --------------
# Create RDS snapshot before stopping (1=yes, 0=no)
CREATE_RDS_SNAPSHOT=1

# Cost Thresholds (for alerts/notifications)
# -------------------------------------------
# Alert if monthly cost exceeds this value
COST_ALERT_THRESHOLD=50

# Maximum acceptable monthly cost
COST_HARD_LIMIT=100

# Logging
# -------
# Directory for logs
LOG_DIR=logs

# Keep logs for this many days
LOG_RETENTION_DAYS=30

# Notifications (Future Enhancement - Fase 3)
# --------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cost-alerts
# EMAIL_RECIPIENT=lucas@example.com

# Advanced Options
# ----------------
# Timeout for AWS CLI commands (seconds)
AWS_CLI_TIMEOUT=300

# Retry attempts for transient failures
MAX_RETRIES=3

# Parallel execution (experimental)
PARALLEL_EXECUTION=0
