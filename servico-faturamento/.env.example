# Variaveis lidas pelas Lambdas Go (cmd/*). Sem valores reais.
DYNAMODB_TABLE_NAME=nfe-main-local
DYNAMODB_EVENTS_TABLE_NAME=nfe-events-local
EVENT_BUS_NAME=nfe-events-local
PDF_BUCKET_NAME=nfe-pdfs-local
CLOUDFRONT_DOMAIN=
CORS_ORIGINS=http://localhost:4200
ENVIRONMENT=local
LOG_LEVEL=info

# Ambiente fiscal: homologacao (tpAmb=2) por padrao.
# Producao exige NFE_AMBIENTE=producao E NFE_CONFIRMAR_PRODUCAO=EMITIR-NFE-COM-VALOR-FISCAL.
NFE_AMBIENTE=homologacao
NFE_CONFIRMAR_PRODUCAO=

# Testes de integracao com DynamoDB Local (go test ./internal/repositorio/)
DYNAMODB_ENDPOINT=http://localhost:8000
