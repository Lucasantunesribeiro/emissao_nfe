{
  "name": "web-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "config:generate": "node ./scripts/generate-runtime-config.mjs",
    "start": "npm run config:generate && ng serve",
    "build": "npm run config:generate && ng build",
    "build:prod": "npm run config:generate && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "analyze": "ng build --configuration production --stats-json && npx webpack-bundle-analyzer dist/web-app/stats.json",
    "test": "npm run config:generate && jest --passWithNoTests",
    "test:ci": "npm run config:generate && jest --passWithNoTests --ci"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.20",
    "@angular/common": "^19.2.20",
    "@angular/compiler": "^19.2.20",
    "@angular/core": "^19.2.20",
    "@angular/forms": "^19.2.20",
    "@angular/platform-browser": "^19.2.20",
    "@angular/platform-browser-dynamic": "^19.2.20",
    "@angular/router": "^19.2.20",
    "aws-amplify": "^6.16.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.20",
    "@angular/cli": "^19.2.20",
    "@angular/compiler-cli": "^19.2.20",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.5.0",
    "autoprefixer": "^10.4.27",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3"
  }
}
